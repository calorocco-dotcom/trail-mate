# Copy to .env. No Cloudflare account or tunnel token is needed.
WSS_HOST=vicliu.i234.me
WSS_PORT=18434
# Directory containing fullchain.pem and privkey.pem, readable by UID 10001.
TLS_CERT_DIR=./certs
DIRECTORY_NAME=Trail Mate public directory
TRACK_DIRECTORY_NAME=Trail Mate public tracks
# Optional comma-separated track discovery hashes (not delivery hashes), max 3.
TRACK_REPLICA_SEEDS=
SITE_ORIGIN=https://vicliu624.github.io
# Per-client raw packets/s and startup burst, each 1..4096. Valid traffic is
# paced with backpressure; MTU 500 and bounded WebSocket queues remain unchanged.
BRIDGE_PACKET_RATE=512
BRIDGE_BURST_PACKETS=128
